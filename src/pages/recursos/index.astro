---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import ResourceCard from "../../components/Cards/ResourceCard.astro";

const categories = ["Todas", "Plantillas", "Fondos", "Canciones", "Videos", "Iconos"];
const initialCategory = categories.includes(Astro.url.searchParams.get("categoria") || "")
  ? Astro.url.searchParams.get("categoria")!
  : "Todas";

const resources = (await getCollection("resources", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Biblioteca de recursos | PROLYRICS PRO"
  description="Explora plantillas, fondos, letras, videos e iconos listos para proyectar en tu iglesia. Descarga gratis o con plan PRO."
>
  <PageHeader
    eyebrow="Biblioteca"
    title="Recursos para tu próximo servicio"
    subtitle="Filtra por categoría o busca por nombre. Todos los archivos están listos para usar en tu software de proyección."
  />

  <section class="bg-slate-50 py-12">
    <div class="container">
      <div class="flex flex-col gap-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm lg:flex-row lg:items-center lg:justify-between">
        <div class="relative flex-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
          <input
            id="search-input"
            type="search"
            placeholder="Buscar recursos, formatos, etiquetas..."
            class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-12 pr-4 text-sm outline-none transition focus:border-violet-400 focus:bg-white focus:ring-2 focus:ring-violet-100"
          />
        </div>

        <label class="flex items-center gap-3 text-sm text-slate-500">
          Ordenar
          <select id="sort-select" class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 outline-none focus:border-violet-400">
            <option value="featured">Destacados primero</option>
            <option value="name">Nombre (A-Z)</option>
            <option value="free">Gratis primero</option>
          </select>
        </label>
      </div>

      <div id="category-filters" class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría">
        {
          categories.map((category) => (
            <button
              type="button"
              data-filter={category}
              class:list={[
                "rounded-full border px-4 py-2 text-sm font-semibold transition",
                category === initialCategory
                  ? "border-violet-600 bg-violet-600 text-white"
                  : "border-slate-200 bg-white text-slate-600 hover:border-violet-300 hover:text-violet-700",
              ]}
            >
              {category}
            </button>
          ))
        }
      </div>

      <p class="mt-6 text-sm text-slate-500">
        Mostrando <span id="result-count" class="font-bold text-slate-900">{resources.length}</span> recursos
      </p>

      <div id="resources-grid" class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {resources.map((resource) => <ResourceCard resource={resource} />)}
      </div>

      <div id="empty-state" class="hidden rounded-2xl border border-dashed border-slate-300 bg-white py-16 text-center">
        <p class="text-lg font-semibold text-slate-900">No encontramos recursos con esos filtros</p>
        <p class="mt-2 text-sm text-slate-500">Prueba con otra palabra o selecciona “Todas”.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ initialCategory }}>
  const searchInput = document.getElementById("search-input");
  const sortSelect = document.getElementById("sort-select");
  const chips = Array.from(document.querySelectorAll("[data-filter]"));
  const grid = document.getElementById("resources-grid");
  const count = document.getElementById("result-count");
  const empty = document.getElementById("empty-state");

  let currentCategory = initialCategory;
  let cards = Array.from(document.querySelectorAll("[data-card]"));

  const escapeHtml = (value) =>
    String(value ?? "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    })[char]);

  const cardMarkup = (item) => `
    <a
      href="/recurso/?slug=${encodeURIComponent(item.slug)}"
      class="card group flex h-full flex-col border border-slate-200/80"
      data-card
      data-title="${escapeHtml(String(item.title || "").toLowerCase())}"
      data-category="${escapeHtml(item.category)}"
      data-format="${escapeHtml(String(item.format || "").toLowerCase())}"
      data-premium="${item.premium ? "true" : "false"}"
      data-featured="${item.featured ? "true" : "false"}"
      data-tags="${escapeHtml((item.tags || []).join(" ").toLowerCase())}"
    >
      <div class="relative aspect-video overflow-hidden bg-ink-900">
        <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-x-0 top-0 flex items-start justify-between p-3">
          <span class="badge bg-black/60 text-white backdrop-blur">${escapeHtml(item.category)}</span>
          ${item.premium
            ? '<span class="badge bg-gradient-to-r from-amber-400 to-orange-500 text-ink-900">PRO</span>'
            : '<span class="badge bg-emerald-500 text-white">Gratis</span>'}
        </div>
      </div>
      <div class="flex flex-1 flex-col p-5">
        <div class="mb-2 flex items-center gap-2 text-xs font-medium text-violet-600">
          ${escapeHtml(item.format)}
        </div>
        <h3 class="text-lg font-bold leading-snug text-slate-900 transition-colors group-hover:text-violet-700">${escapeHtml(item.title)}</h3>
        <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-500">${escapeHtml(item.description)}</p>
        <span class="mt-auto pt-5 text-sm font-semibold text-violet-600">Ver recurso <span class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
      </div>
    </a>`;

  const apply = () => {
    const query = searchInput.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const matchesCategory = currentCategory === "Todas" || card.dataset.category === currentCategory;
      const haystack = `${card.dataset.title} ${card.dataset.format} ${card.dataset.tags}`;
      const matchesQuery = !query || haystack.includes(query);
      const show = matchesCategory && matchesQuery;
      card.style.display = show ? "" : "none";
      if (show) visible += 1;
    });

    count.textContent = String(visible);
    empty.classList.toggle("hidden", visible !== 0);

    const order = sortSelect.value;
    const sorted = [...cards].sort((a, b) => {
      if (order === "name") return a.dataset.title.localeCompare(b.dataset.title);
      if (order === "free") return Number(a.dataset.premium) - Number(b.dataset.premium);
      return Number(b.dataset.featured) - Number(a.dataset.featured);
    });
    sorted.forEach((card) => grid.appendChild(card));

    const url = new URL(window.location.href);
    if (currentCategory === "Todas") url.searchParams.delete("categoria");
    else url.searchParams.set("categoria", currentCategory);
    window.history.replaceState({}, "", url);
  };

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      currentCategory = chip.dataset.filter;
      chips.forEach((other) => {
        const active = other === chip;
        other.classList.toggle("bg-violet-600", active);
        other.classList.toggle("text-white", active);
        other.classList.toggle("border-violet-600", active);
        other.classList.toggle("bg-white", !active);
        other.classList.toggle("text-slate-600", !active);
        other.classList.toggle("border-slate-200", !active);
      });
      apply();
    });
  });

  searchInput.addEventListener("input", apply);
  sortSelect.addEventListener("change", apply);
  apply();

  fetch("/api/resources")
    .then((response) => response.json())
    .then((data) => {
      if (!Array.isArray(data.resources) || data.resources.length === 0) return;
      grid.innerHTML = data.resources.map(cardMarkup).join("");
      cards = Array.from(document.querySelectorAll("[data-card]"));
      apply();
    })
    .catch(() => {
      // Si la API no está disponible se mantienen los recursos generados en el build.
    });
</script>
