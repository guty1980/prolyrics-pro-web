---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/Sections/PageHeader.astro";
import Button from "../components/UI/Button.astro";
---

<BaseLayout
  title="Contacto | PROLYRICS PRO"
  description="¿Tienes una pregunta o necesitas un recurso personalizado? Escríbenos al equipo de PROLYRICS PRO."
>
  <PageHeader
    eyebrow="Contacto"
    title="Hablemos"
    subtitle="Respondemos normalmente en menos de 48 horas."
  />

  <section class="py-16">
    <div class="container grid gap-12 lg:grid-cols-[1fr_380px]">
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <h2 class="text-2xl font-bold">Envíanos un mensaje</h2>
        <p class="mt-2 text-sm text-slate-500">Completa el formulario y te responderemos pronto.</p>

        <form name="contacto" method="POST" data-netlify="true" class="mt-8 space-y-5">
          <input type="hidden" name="form-name" value="contacto" />
          <div>
            <label for="nombre" class="mb-2 block text-sm font-semibold text-slate-700">Nombre</label>
            <input id="nombre" name="nombre" type="text" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-violet-400 focus:bg-white focus:ring-2 focus:ring-violet-100" />
          </div>
          <div>
            <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">Correo electrónico</label>
            <input id="email" name="email" type="email" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-violet-400 focus:bg-white focus:ring-2 focus:ring-violet-100" />
          </div>
          <div>
            <label for="iglesia" class="mb-2 block text-sm font-semibold text-slate-700">Iglesia o ministerio</label>
            <input id="iglesia" name="iglesia" type="text" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-violet-400 focus:bg-white focus:ring-2 focus:ring-violet-100" />
          </div>
          <div>
            <label for="mensaje" class="mb-2 block text-sm font-semibold text-slate-700">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="5" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-violet-400 focus:bg-white focus:ring-2 focus:ring-violet-100"></textarea>
          </div>
          <Button type="submit" size="lg">Enviar mensaje</Button>
          <p class="text-xs text-slate-400">Al enviar aceptas nuestra política de privacidad.</p>
        </form>
      </div>

      <aside class="space-y-6">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7">
          <h3 class="text-lg font-bold">Correo</h3>
          <a href="mailto:hola@prolyricspro.com" class="mt-2 block text-violet-600 hover:underline">hola@prolyricspro.com</a>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7">
          <h3 class="text-lg font-bold">¿Buscas algo específico?</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500">
            Si necesitas una plantilla personalizada para un evento o temporada, cuéntanos los detalles y lo evaluamos contigo.
          </p>
        </div>
        <div class="rounded-2xl bg-gradient-to-br from-violet-600 to-blue-600 p-7 text-white">
          <h3 class="text-lg font-bold text-white">¿Solo quieres explorar?</h3>
          <p class="mt-2 text-sm text-violet-100">La biblioteca gratuita está abierta para todos.</p>
          <div class="mt-5">
            <Button href="/recursos" variant="secondary">Ver recursos</Button>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
