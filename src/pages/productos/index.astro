---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import { seedProducts } from "../../../netlify/functions/_lib/seed-products.mjs";
import { seedPackages } from "../../../netlify/functions/_lib/seed-packages.mjs";

const initialProducts = seedProducts
  .filter((product) => !product.draft)
  .sort((a, b) => Number(a.order || 0) - Number(b.order || 0));

const initialPackages = seedPackages
  .filter((pkg) => !pkg.draft)
  .sort((a, b) => Number(a.order || 0) - Number(b.order || 0));
---

<BaseLayout
  title="Productos digitales | CREATIVOX"
  description="Explora el catálogo de aplicaciones, software y recursos digitales de CREATIVOX."
>
  <PageHeader
    eyebrow="Catálogo"
    title="Productos digitales CREATIVOX"
    subtitle="Herramientas listas para usar. Cada producto con sus detalles de venta y funcionalidades."
  />

  <section class="py-16 border-b border-slate-200" id="paquetes">
    <div class="container">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <span class="text-sm font-bold uppercase tracking-[0.2em] text-violet-600">Paquetes</span>
          <h2 class="mt-3 text-3xl font-extrabold text-slate-900">Paquetes listos para usar</h2>
          <p class="mt-4 text-lg text-slate-500">Paquetes de videos, imágenes, archivos JSON y más, creados para que los descargues y uses al instante.</p>
        </div>
      </div>

      <div id="packages-grid" class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          initialPackages.map((pkg) => (
            <article class="card group flex h-full flex-col border border-slate-200/80">
              <div class="relative aspect-video overflow-hidden bg-ink-900">
                <img
                  src={pkg.image || "/og-image.png"}
                  alt={pkg.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-x-0 top-0 flex items-start justify-between p-3">
                  <span class="badge bg-black/60 text-white backdrop-blur">{pkg.category || "Paquete"}</span>
                  <span class="badge bg-violet-600 text-white">{pkg.priceLabel || "Gratis"}</span>
                </div>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-bold leading-snug text-slate-900">{pkg.title}</h3>
                <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-500">{pkg.description || pkg.tagline}</p>
                {pkg.files?.length ? (
                  <p class="mt-3 text-xs font-medium text-violet-600">{pkg.files.length} archivo(s) incluido(s)</p>
                ) : null}
                <div class="mt-auto flex flex-wrap gap-2 pt-5">
                  {(pkg.files || []).slice(0, 2).map((file) => (
                    <a href={file.url || (file.key ? `/api/media?key=${encodeURIComponent(file.key)}&download=1` : "#")} class="inline-flex items-center rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-violet-50 hover:text-violet-700" download>
                      {file.name || "Archivo"}
                    </a>
                  ))}
                  {(pkg.files || []).length > 2 && <span class="inline-flex items-center px-1 text-xs text-slate-400">+{pkg.files.length - 2} más</span>}
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p id="packages-empty" class="mt-10 hidden text-center text-slate-500">No hay paquetes publicados todavía.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900">Todos los productos</h2>
          <p class="mt-1 text-sm text-slate-500" id="product-count">{initialProducts.length} productos disponibles</p>
        </div>
        <a href="/cuenta" class="text-sm font-semibold text-violet-600 hover:text-violet-800">¿Ya tienes cuenta? Accede →</a>
      </div>

      <div id="products-grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          initialProducts.map((product) => (
            <a
              href={`/producto/?slug=${product.slug}`}
              class="card group flex flex-col"
            >
              <div class="relative aspect-video overflow-hidden bg-ink-900">
                <img
                  src={product.image || "/og-image.png"}
                  alt={product.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <span class="badge absolute left-4 top-4 bg-black/60 text-white backdrop-blur">{product.category}</span>
                {product.featured && (
                  <span class="badge brand-gradient absolute right-4 top-4 text-white">Destacado</span>
                )}
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-xl font-extrabold text-slate-900">{product.title}</h3>
                <p class="mt-1 line-clamp-1 text-sm text-slate-500">{product.tagline}</p>
                <p class="mt-4 line-clamp-2 text-sm text-slate-600">{product.description}</p>
                <div class="mt-auto flex items-center justify-between pt-6">
                  <span class="text-lg font-black text-slate-900">{product.priceLabel}</span>
                  <span class="text-sm font-semibold text-violet-600">Ver detalles →</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <p id="products-empty" class="mt-10 hidden text-center text-slate-500">No hay productos publicados todavía.</p>
    </div>
  </section>

  <script define:vars={{ fallbackCount: initialProducts.length }}>
    const esc = (value) =>
      String(value ?? "").replace(/[&<>"']/g, (char) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char]),
      );

    function fileHref(file) {
      if (!file) return "#";
      if (file.url) return String(file.url);
      if (file.key) return `/api/media?key=${encodeURIComponent(file.key)}&download=1`;
      return "#";
    }

    function packageCardMarkup(pkg) {
      const image = pkg.image || "/og-image.png";
      const files = Array.isArray(pkg.files) ? pkg.files : [];
      const fileButtons = files.slice(0, 2).map((file) =>
        `<a href="${esc(fileHref(file))}" class="inline-flex items-center rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-violet-50 hover:text-violet-700" download>${esc(file.name || "Archivo")}</a>`
      ).join("");
      const more = files.length > 2 ? `<span class="inline-flex items-center px-1 text-xs text-slate-400">+${files.length - 2} más</span>` : "";
      const filesLine = files.length ? `<p class="mt-3 text-xs font-medium text-violet-600">${files.length} archivo(s) incluido(s)</p>` : "";
      return `
        <article class="card group flex h-full flex-col border border-slate-200/80">
          <div class="relative aspect-video overflow-hidden bg-ink-900">
            <img src="${esc(image)}" alt="${esc(pkg.title)}" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-x-0 top-0 flex items-start justify-between p-3">
              <span class="badge bg-black/60 text-white backdrop-blur">${esc(pkg.category || "Paquete")}</span>
              <span class="badge bg-violet-600 text-white">${esc(pkg.priceLabel || "Gratis")}</span>
            </div>
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h3 class="text-lg font-bold leading-snug text-slate-900">${esc(pkg.title)}</h3>
            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-500">${esc(pkg.description || pkg.tagline || "")}</p>
            ${filesLine}
            <div class="mt-auto flex flex-wrap gap-2 pt-5">${fileButtons}${more}</div>
          </div>
        </article>`;
    }

    function cardMarkup(product) {
      const image = product.image || "/og-image.png";
      return `
        <a href="/producto/?slug=${esc(product.slug)}" class="card group flex flex-col">
          <div class="relative aspect-video overflow-hidden bg-ink-900">
            <img src="${esc(image)}" alt="${esc(product.title)}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            <span class="badge absolute left-4 top-4 bg-black/60 text-white backdrop-blur">${esc(product.category || "Producto")}</span>
            ${product.featured ? '<span class="badge brand-gradient absolute right-4 top-4 text-white">Destacado</span>' : ""}
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-xl font-extrabold text-slate-900">${esc(product.title)}</h3>
            <p class="mt-1 line-clamp-1 text-sm text-slate-500">${esc(product.tagline || "")}</p>
            <p class="mt-4 line-clamp-2 text-sm text-slate-600">${esc(product.description || "")}</p>
            <div class="mt-auto flex items-center justify-between pt-6">
              <span class="text-lg font-black text-slate-900">${esc(product.priceLabel || "")}</span>
              <span class="text-sm font-semibold text-violet-600">Ver detalles →</span>
            </div>
          </div>
        </a>`;
    }

    fetch("/api/packages")
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || !Array.isArray(data.packages)) return;
        const grid = document.getElementById("packages-grid");
        const empty = document.getElementById("packages-empty");
        if (!grid || !empty) return;
        if (data.packages.length === 0) {
          grid.innerHTML = "";
          empty.classList.remove("hidden");
        } else {
          empty.classList.add("hidden");
          grid.innerHTML = data.packages.map(packageCardMarkup).join("");
        }
      })
      .catch(() => {});

    fetch("/api/products")
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || !Array.isArray(data.products)) return;
        const grid = document.getElementById("products-grid");
        const empty = document.getElementById("products-empty");
        const count = document.getElementById("product-count");
        if (!grid || !empty || !count) return;
        if (data.products.length === 0) {
          grid.innerHTML = "";
          empty.classList.remove("hidden");
        } else {
          grid.innerHTML = data.products.map(cardMarkup).join("");
        }
        count.textContent = `${data.products.length} productos disponibles`;
      })
      .catch(() => {});
  </script>
</BaseLayout>
