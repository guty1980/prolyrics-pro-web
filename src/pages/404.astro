---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/UI/Button.astro";
---

<BaseLayout title="Página no encontrada | PROLYRICS PRO" description="La página que buscas no existe.">
  <section class="gradient-brand flex min-h-[60vh] items-center text-white">
    <div class="container text-center">
      <p class="text-7xl font-black text-white/20">404</p>
      <h1 class="mt-2 text-white">No encontramos esa página</h1>
      <p class="mt-4 text-slate-300">Puede que el enlace haya cambiado o que la página ya no exista.</p>
      <div class="mt-8">
        <Button href="/" size="lg" variant="secondary">Volver al inicio</Button>
      </div>
    </div>
  </section>
</BaseLayout>
