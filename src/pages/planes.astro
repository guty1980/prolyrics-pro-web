---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/Sections/PageHeader.astro";
import Button from "../components/UI/Button.astro";

const plans = [
  {
    name: "Gratis",
    price: "$0",
    period: "/mes",
    description: "Ideal para dar el primer paso.",
    features: [
      "Acceso a recursos gratuitos",
      "Descargas ilimitadas",
      "Actualizaciones mensuales",
      "Formato 16:9",
    ],
    cta: "Explorar recursos gratis",
    href: "/recursos",
    highlighted: false,
  },
  {
    name: "PRO",
    price: "$19",
    period: "/mes",
    description: "El catálogo completo para tu equipo.",
    features: [
      "Todo el catálogo de recursos",
      "Archivos editables y fuentes",
      "Nuevos recursos cada semana",
      "Sin marcas de agua",
      "Descargas en lotes",
    ],
    cta: "Solicitar plan PRO",
    href: "/contacto",
    highlighted: true,
  },
  {
    name: "Iglesia",
    price: "$39",
    period: "/mes",
    description: "Para equipos grandes o multisede.",
    features: [
      "Todo lo incluido en PRO",
      "Hasta 10 usuarios",
      "Recursos personalizados",
      "Soporte prioritario",
      "Factura mensual",
    ],
    cta: "Solicitar plan Iglesia",
    href: "/contacto",
    highlighted: false,
  },
];

const faqs = [
  {
    question: "¿Puedo usar los recursos en ProPresenter o PowerPoint?",
    answer: "Sí. Los archivos se entregan en formatos estándar (SVG, PNG, PPTX) compatibles con ProPresenter, PowerPoint, Keynote y la mayoría de los softwares de proyección.",
  },
  {
    question: "¿Los recursos son editables?",
    answer: "Los recursos del plan PRO incluyen archivos editables para que cambies colores, textos e imágenes con el nombre de tu iglesia.",
  },
  {
    question: "¿Puedo cancelar cuando quiera?",
    answer: "Sí. No hay contratos de permanencia. Puedes cancelar tu suscripción en cualquier momento desde tu cuenta.",
  },
  {
    question: "¿Ofrecen recursos en español?",
    answer: "Todo el catálogo está pensado para iglesias de habla hispana, con textos y diseños en español.",
  },
];
---

<BaseLayout
  title="Planes y precios | PROLYRICS PRO"
  description="Elige el plan perfecto para tu iglesia: recursos gratuitos, plan PRO con todo el catálogo o plan Iglesia para equipos grandes."
>
  <PageHeader
    eyebrow="Planes"
    title="Simple, transparente y sin sorpresas"
    subtitle="Empieza gratis. Crece cuando tu ministerio lo necesite."
  />

  <section class="py-16">
    <div class="container">
      <div class="grid gap-6 lg:grid-cols-3">
        {
          plans.map((plan) => (
            <div
              class:list={[
                "relative flex flex-col rounded-2xl border p-8",
                plan.highlighted
                  ? "border-violet-600 bg-gradient-to-b from-violet-50 to-white shadow-glow"
                  : "border-slate-200 bg-white shadow-sm",
              ]}
            >
              {plan.highlighted && (
                <span class="badge absolute -top-3 left-8 bg-gradient-to-r from-violet-600 to-blue-600 text-white">
                  Más elegido
                </span>
              )}
              <h2 class="text-2xl font-bold">{plan.name}</h2>
              <p class="mt-2 text-sm text-slate-500">{plan.description}</p>
              <p class="mt-6">
                <span class="text-5xl font-black text-slate-900">{plan.price}</span>
                <span class="text-sm text-slate-500">{plan.period}</span>
              </p>
              <ul class="mt-7 flex-1 space-y-3">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3 text-sm text-slate-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 flex-none text-violet-600" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
              <Button href={plan.href} variant={plan.highlighted ? "primary" : "outline"} class="mt-8 w-full">
                {plan.cta}
              </Button>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50 py-16">
    <div class="container">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center">Preguntas frecuentes</h2>
        <div class="mt-10 space-y-4">
          {
            faqs.map((faq) => (
              <details class="group rounded-2xl border border-slate-200 bg-white p-6">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900">
                  {faq.question}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-none text-violet-600" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                  </svg>
                </summary>
                <p class="mt-4 leading-relaxed text-slate-600">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
