---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/Sections/HeroSection.astro";
import Button from "../components/UI/Button.astro";
import ResourceCard from "../components/Cards/ResourceCard.astro";

const allResources = await getCollection("resources", ({ data }) => !data.draft);
const featured = allResources
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const categories = [
  {
    name: "Plantillas",
    count: "45+",
    description: "Versos, títulos, anuncios y más.",
    href: "/recursos?categoria=Plantillas",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
  },
  {
    name: "Fondos",
    count: "30+",
    description: "Fondos 16:9 para cada temporada.",
    href: "/recursos?categoria=Fondos",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m21 15-5-5L5 20"/></svg>`,
  },
  {
    name: "Canciones",
    count: "25+",
    description: "Letras listas para proyectar.",
    href: "/recursos?categoria=Canciones",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
  },
  {
    name: "Videos",
    count: "12+",
    description: "Loops y motion para tu stream.",
    href: "/recursos?categoria=Videos",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="m10 9 5 3-5 3V9z"/></svg>`,
  },
  {
    name: "Iconos",
    count: "8+",
    description: "Iconos y elementos gráficos.",
    href: "/recursos?categoria=Iconos",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 2.1 6.4H21l-5.5 4 2.1 6.4L12 14.8 6.4 18.8 8.5 12.4 3 8.4h6.9L12 2z"/></svg>`,
  },
];

const steps = [
  {
    title: "Elige un recurso",
    text: "Explora la biblioteca y filtra por categoría, formato o temporada.",
    number: "01",
  },
  {
    title: "Descarga y personaliza",
    text: "Archivos listos para ProPresenter, PowerPoint o tu software favorito.",
    number: "02",
  },
  {
    title: "Proyecta y bendice",
    text: "Sube el archivo a tu pantalla y enfócate en lo importante: la alabanza.",
    number: "03",
  },
];

const plans = [
  {
    name: "Gratis",
    price: "$0",
    period: "/mes",
    description: "Para empezar con recursos esenciales.",
    features: ["Recursos gratuitos", "Descargas ilimitadas", "Actualizaciones mensuales"],
    cta: "Explorar gratis",
    href: "/planes",
    highlighted: false,
  },
  {
    name: "PRO",
    price: "$19",
    period: "/mes",
    description: "Todo el catálogo para tu equipo.",
    features: ["Todo el catálogo", "Archivos editables", "Nuevos recursos cada semana", "Sin marcas de agua"],
    cta: "Ver plan PRO",
    href: "/planes",
    highlighted: true,
  },
  {
    name: "Iglesia",
    price: "$39",
    period: "/mes",
    description: "Para equipos grandes y multisede.",
    features: ["Todo lo de PRO", "Hasta 10 usuarios", "Recursos personalizados", "Soporte prioritario"],
    cta: "Ver plan Iglesia",
    href: "/planes",
    highlighted: false,
  },
];
---

<BaseLayout>
  <HeroSection />

  <!-- Categorías -->
  <section class="bg-slate-50 py-20">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center">
        <span class="text-sm font-bold uppercase tracking-[0.2em] text-violet-600">Biblioteca</span>
        <h2 class="mt-3">Todo lo que tu proyección necesita</h2>
        <p class="mt-4 text-lg text-slate-500">
          Recursos organizados para que encuentres exactamente lo que buscas en segundos.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {
          categories.map((category) => (
            <a
              href={category.href}
              class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg"
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-50 text-violet-600 transition-colors group-hover:bg-violet-600 group-hover:text-white">
                <Fragment set:html={category.icon} />
              </span>
              <h3 class="mt-5 text-lg font-bold">{category.name}</h3>
              <p class="mt-1 text-sm text-slate-500">{category.description}</p>
              <p class="mt-4 text-xs font-bold uppercase tracking-wider text-violet-600">{category.count} recursos</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Recursos destacados -->
  <section class="py-20">
    <div class="container">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <span class="text-sm font-bold uppercase tracking-[0.2em] text-violet-600">Destacados</span>
          <h2 class="mt-3">Los favoritos de esta semana</h2>
          <p class="mt-4 text-lg text-slate-500">Diseños listos para usar, creados por y para iglesias.</p>
        </div>
        <Button href="/recursos" variant="outline">Ver todos los recursos →</Button>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((resource) => <ResourceCard resource={resource} />)}
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="border-y border-slate-200 bg-slate-50 py-20">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center">
        <span class="text-sm font-bold uppercase tracking-[0.2em] text-violet-600">Simple</span>
        <h2 class="mt-3">De la idea a la pantalla en 3 pasos</h2>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {
          steps.map((step) => (
            <div class="relative rounded-2xl bg-white p-8 shadow-sm">
              <span class="text-5xl font-black text-violet-100">{step.number}</span>
              <h3 class="mt-2 text-xl font-bold">{step.title}</h3>
              <p class="mt-3 leading-relaxed text-slate-500">{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Planes -->
  <section class="py-20">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center">
        <span class="text-sm font-bold uppercase tracking-[0.2em] text-violet-600">Planes</span>
        <h2 class="mt-3">Un plan para cada equipo</h2>
        <p class="mt-4 text-lg text-slate-500">Empieza gratis y crece cuando lo necesites.</p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          plans.map((plan) => (
            <div
              class:list={[
                "relative flex flex-col rounded-2xl border p-8 shadow-sm",
                plan.highlighted
                  ? "border-violet-600 bg-gradient-to-b from-violet-50 to-white shadow-glow"
                  : "border-slate-200 bg-white",
              ]}
            >
              {plan.highlighted && (
                <span class="badge absolute -top-3 left-8 bg-gradient-to-r from-violet-600 to-blue-600 text-white">
                  Más elegido
                </span>
              )}
              <h3 class="text-xl font-bold">{plan.name}</h3>
              <p class="mt-2 text-sm text-slate-500">{plan.description}</p>
              <p class="mt-6">
                <span class="text-4xl font-black text-slate-900">{plan.price}</span>
                <span class="text-sm text-slate-500">{plan.period}</span>
              </p>
              <ul class="mt-6 flex-1 space-y-3">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3 text-sm text-slate-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 flex-none text-violet-600" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
              <Button href={plan.href} variant={plan.highlighted ? "primary" : "outline"} class="mt-8 w-full">
                {plan.cta}
              </Button>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonios -->
  <section class="bg-ink-900 py-20 text-white">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center">
        <span class="text-sm font-bold uppercase tracking-[0.2em] text-violet-400">Testimonios</span>
        <h2 class="mt-3 text-white">Equipos que ya ahorran tiempo</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <blockquote class="rounded-2xl border border-white/10 bg-white/5 p-7">
          <p class="text-sm leading-relaxed text-slate-300">“Antes preparábamos las diapositivas la noche anterior. Ahora elegimos una plantilla y listo.”</p>
          <footer class="mt-5 text-sm font-semibold text-white">— Equipo de alabanza, Madrid</footer>
        </blockquote>
        <blockquote class="rounded-2xl border border-white/10 bg-white/5 p-7">
          <p class="text-sm leading-relaxed text-slate-300">“Los fondos son preciosos y funcionan perfecto en ProPresenter. Un cambio total en nuestros servicios.”</p>
          <footer class="mt-5 text-sm font-semibold text-white">— Ministerio de medios, Bogotá</footer>
        </blockquote>
        <blockquote class="rounded-2xl border border-white/10 bg-white/5 p-7">
          <p class="text-sm leading-relaxed text-slate-300">“Por fin algo pensado para iglesias pequeñas con presupuesto pequeño. Gracias.”</p>
          <footer class="mt-5 text-sm font-semibold text-white">— Iglesia Nueva Esperanza, Lima</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="gradient-brand py-20 text-white">
    <div class="container text-center">
      <h2 class="text-white">Haz que cada servicio se vea increíble</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-300">
        Explora la biblioteca y descarga tus primeros recursos gratis hoy mismo.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <Button href="/recursos" size="lg">Explorar recursos</Button>
        <Button href="/contacto" variant="ghost" size="lg">Escríbenos</Button>
      </div>
    </div>
  </section>
</BaseLayout>
