---
const currentYear = new Date().getFullYear();

const groups = [
  {
    title: "Catálogo",
    items: [
      { text: "Todos los productos", href: "/productos" },
      { text: "PROLYRICS", href: "/producto/?slug=prolyrics" },
      { text: "Recursos", href: "/recursos" },
      { text: "Planes", href: "/planes" },
    ],
  },
  {
    title: "CREATIVOX",
    items: [
      { text: "Mi cuenta", href: "/cuenta" },
      { text: "Sobre nosotros", href: "/nosotros" },
      { text: "Contacto", href: "/contacto" },
      { text: "Panel de administrador", href: "/admin" },
    ],
  },
  {
    title: "Legal",
    items: [
      { text: "Privacidad", href: "/privacidad" },
      { text: "Términos de uso", href: "/terminos" },
      { text: "Licencias", href: "/terminos#licencias" },
    ],
  },
];
---

<footer class="border-t border-white/10 bg-ink-900 pt-16 pb-8 text-slate-300">
  <div class="container">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3">
          <span class="brand-mark flex h-10 w-10 items-center justify-center rounded-xl brand-gradient overflow-hidden" data-brand-mark>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2 2 7l10 5 10-5-10-5z" />
              <path d="m2 17 10 5 10-5" />
              <path d="m2 12 10 5 10-5" />
            </svg>
          </span>
          <span class="text-lg font-extrabold text-white" data-brand-name>CREATIVOX</span>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-slate-400">
          Productos digitales, aplicaciones y software para llevar tu proyecto al siguiente nivel. Herramientas listas para usar, creadas para personas reales.
        </p>
        <a href="mailto:hola@creativox.com" class="mt-5 inline-block text-sm font-medium text-violet-300 hover:text-white" data-brand-email>
          hola@creativox.com
        </a>
      </div>

      {
        groups.map((group) => (
          <div>
            <h3 class="mb-4 text-sm font-bold uppercase tracking-wider text-white">{group.title}</h3>
            <ul class="space-y-3">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class="text-sm text-slate-400 transition-colors hover:text-violet-300">
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-xs text-slate-500 sm:flex-row">
      <p>&copy; {currentYear} CREATIVOX. Todos los derechos reservados.</p>
      <p>Productos digitales con ♥</p>
    </div>
  </div>
</footer>
