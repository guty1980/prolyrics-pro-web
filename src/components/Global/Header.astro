---
import Navigation from "./Navigation.astro";
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-ink-900/95 backdrop-blur-lg">
  <div class="container flex items-center justify-between h-20">
    <a href="/" class="flex items-center gap-3" aria-label="CREATIVOX - Inicio">
      <span class="brand-mark flex h-10 w-10 items-center justify-center rounded-xl brand-gradient shadow-glow overflow-hidden" data-brand-mark>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2 2 7l10 5 10-5-10-5z" />
          <path d="m2 17 10 5 10-5" />
          <path d="m2 12 10 5 10-5" />
        </svg>
      </span>
      <span class="leading-tight">
        <span class="block text-lg font-extrabold tracking-tight text-white" data-brand-name>CREATIVOX</span>
        <span class="block text-[10px] font-medium uppercase tracking-[0.18em] text-slate-400" data-brand-tagline>Productos digitales</span>
      </span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <Navigation />

      <a
        href="/cuenta"
        class="rounded-lg p-2 text-slate-400 transition-colors hover:bg-white/10 hover:text-violet-300"
        aria-label="Mi cuenta"
        title="Mi cuenta"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
      </a>

      <a
        href="/admin"
        class="rounded-lg p-2 text-slate-400 transition-colors hover:bg-white/10 hover:text-violet-300"
        aria-label="Panel de administrador"
        title="Panel de administrador"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 15.5a3.5 3.5 0 100-7 3.5 3.5 0 000 7z" />
          <path d="M19.4 15a1.7 1.7 0 00.34 1.88l.06.06a2 2 0 11-2.83 2.83l-.06-.06A1.7 1.7 0 0015 19.4a1.7 1.7 0 00-1 .6 1.7 1.7 0 00-.4 1.1V21a2 2 0 11-4 0v-.09A1.7 1.7 0 008.3 19.4a1.7 1.7 0 00-1.88.34l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.7 1.7 0 004.6 15a1.7 1.7 0 00-.6-1 1.7 1.7 0 00-1.1-.4H3a2 2 0 110-4h.09A1.7 1.7 0 004.6 8.3a1.7 1.7 0 00-.34-1.88l-.06-.06a2 2 0 112.83-2.83l.06.06A1.7 1.7 0 009 4.6a1.7 1.7 0 001-.6 1.7 1.7 0 00.4-1.1V3a2 2 0 114 0v.09a1.7 1.7 0 00.5 1.2 1.7 1.7 0 001.1.4 1.7 1.7 0 001.88-.34l.06-.06a2 2 0 112.83 2.83l-.06.06A1.7 1.7 0 0019.4 9c.12.38.36.7.68.93.3.22.66.34 1.03.34H21a2 2 0 110 4h-.09a1.7 1.7 0 00-1.51.73z" />
        </svg>
      </a>
    </div>
  </div>
</header>
