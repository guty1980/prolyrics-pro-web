---
import Navigation from "./Navigation.astro";
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-ink-900/95 backdrop-blur-lg">
  <div class="container flex items-center justify-between h-20">
    <a href="/" class="flex items-center gap-3" aria-label="PROLYRICS PRO - Inicio">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500 to-blue-600 shadow-glow">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18V5l12-2v13" />
          <circle cx="6" cy="18" r="3" />
          <circle cx="18" cy="16" r="3" />
        </svg>
      </span>
      <span class="leading-tight">
        <span class="block text-lg font-extrabold tracking-tight text-white">PROLYRICS <span class="text-violet-400">PRO</span></span>
        <span class="block text-[10px] font-medium uppercase tracking-[0.18em] text-slate-400">Proyección para iglesias</span>
      </span>
    </a>

    <Navigation />
  </div>
</header>
