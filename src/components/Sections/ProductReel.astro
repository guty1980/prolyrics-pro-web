---
import { seedProducts } from "../../../netlify/functions/_lib/seed-products.mjs";

const initialProducts = seedProducts
  .filter((product) => !product.draft)
  .sort((a, b) => Number(a.order || 0) - Number(b.order || 0));
---

<section class="relative overflow-hidden bg-ink-900 py-20 text-white" id="productos-reel">
  <div class="pointer-events-none absolute -left-40 top-0 h-96 w-96 rounded-full bg-violet-600/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-40 bottom-0 h-96 w-96 rounded-full bg-blue-600/20 blur-3xl"></div>

  <div class="container relative">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <span class="text-sm font-bold uppercase tracking-[0.2em] text-violet-400">Catálogo CREATIVOX</span>
        <h2 class="mt-3 text-white">Productos que están haciendo la diferencia</h2>
        <p class="mt-4 text-lg text-slate-300">
          Descubre nuestras aplicaciones y recursos digitales. Cada producto con sus detalles de venta y funcionalidades.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <button
          id="reel-prev"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-white/20 bg-white/5 transition hover:bg-white/15"
          type="button"
          aria-label="Producto anterior"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button
          id="reel-next"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-white/20 bg-white/5 transition hover:bg-white/15"
          type="button"
          aria-label="Producto siguiente"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
        </button>
        <a href="/productos" class="ml-2 hidden text-sm font-semibold text-violet-300 hover:text-white sm:inline-block">
          Ver todo →
        </a>
      </div>
    </div>

    <div
      id="reel-track"
      class="mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-4"
      style="scrollbar-width: none;"
    >
      {
        initialProducts.map((product) => (
          <a
            href={`/producto/?slug=${product.slug}`}
            class="reel-card group relative aspect-[16/10] w-[290px] flex-none snap-start overflow-hidden rounded-2xl border border-white/10 bg-ink-800 sm:w-[340px]"
          >
            <img
              src={product.image || "/og-image.png"}
              alt={product.title}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/50 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5">
              <div class="flex items-center gap-2">
                <span class="badge bg-white/15 text-white backdrop-blur">{product.category}</span>
                {product.featured && <span class="badge brand-gradient text-white">Destacado</span>}
              </div>
              <h3 class="mt-3 text-xl font-extrabold text-white">{product.title}</h3>
              <p class="mt-1 line-clamp-1 text-sm text-slate-300">{product.tagline}</p>
              <div class="mt-4 flex items-center justify-between">
                <span class="text-sm font-bold text-white">{product.priceLabel}</span>
                <span class="text-sm font-semibold text-violet-300">Ver producto →</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-4 flex items-center justify-center gap-2" id="reel-dots" aria-hidden="true"></div>
  </div>
</section>

<script>
  type ReelProduct = {
    slug: string;
    title: string;
    tagline?: string;
    category?: string;
    priceLabel?: string;
    image?: string;
    featured?: boolean;
  };

  const esc = (value: unknown) =>
    String(value ?? "").replace(/[&<>"']/g, (char) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char] as string),
    );

  const track = document.getElementById("reel-track");
  const dots = document.getElementById("reel-dots");
  let timer: number | undefined;

  function cardMarkup(product: ReelProduct) {
    const image = product.image || "/og-image.png";
    return `
      <a href="/producto/?slug=${esc(product.slug)}" class="reel-card group relative aspect-[16/10] w-[290px] flex-none snap-start overflow-hidden rounded-2xl border border-white/10 bg-ink-800 sm:w-[340px]">
        <img src="${esc(image)}" alt="${esc(product.title)}" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/50 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-5">
          <div class="flex items-center gap-2">
            <span class="badge bg-white/15 text-white backdrop-blur">${esc(product.category || "Producto")}</span>
            ${product.featured ? '<span class="badge brand-gradient text-white">Destacado</span>' : ""}
          </div>
          <h3 class="mt-3 text-xl font-extrabold text-white">${esc(product.title)}</h3>
          <p class="mt-1 line-clamp-1 text-sm text-slate-300">${esc(product.tagline || "")}</p>
          <div class="mt-4 flex items-center justify-between">
            <span class="text-sm font-bold text-white">${esc(product.priceLabel || "")}</span>
            <span class="text-sm font-semibold text-violet-300">Ver producto →</span>
          </div>
        </div>
      </a>`;
  }

  function buildDots(count: number) {
    if (!dots) return;
    dots.innerHTML = Array.from({ length: count }, (_, i) =>
      `<span class="h-1.5 rounded-full transition-all ${i === 0 ? "w-6 bg-violet-400" : "w-1.5 bg-white/25"}"></span>`,
    ).join("");
  }

  function currentIndex() {
    if (!track) return 0;
    const first = track.querySelector(".reel-card") as HTMLElement | null;
    if (!first) return 0;
    const step = first.offsetWidth + 20;
    return Math.round(track.scrollLeft / step);
  }

  function updateDots() {
    if (!dots || !track) return;
    const count = track.querySelectorAll(".reel-card").length;
    const index = currentIndex();
    Array.from(dots.children).forEach((dot, i) => {
      dot.className = `h-1.5 rounded-full transition-all ${i === index ? "w-6 bg-violet-400" : "w-1.5 bg-white/25"}`;
    });
  }

  function leftForIndex(index: number): number {
    if (!track) return 0;
    const cards = track.querySelectorAll<HTMLElement>(".reel-card");
    if (!cards.length) return 0;
    const safeIndex = ((index % cards.length) + cards.length) % cards.length;
    const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
    return Math.min(Math.max(0, cards[safeIndex].offsetLeft - track.offsetLeft), maxScroll);
  }

  function scrollToIndex(index: number, behavior: ScrollBehavior = "smooth") {
    if (!track) return;
    track.scrollTo({ left: leftForIndex(index), behavior });
  }

  function next() {
    if (!track) return;
    const cards = track.querySelectorAll(".reel-card");
    if (!cards.length) return;
    const following = currentIndex() + 1;
    // Al llegar al final el último índice apunta al mismo scroll máximo:
    // detectarlo y volver al inicio evita que el reel se quede trabado.
    if (following >= cards.length || Math.abs(leftForIndex(following) - track.scrollLeft) < 3) {
      scrollToIndex(0, "auto");
      return;
    }
    scrollToIndex(following);
  }

  function prev() {
    if (!track) return;
    const cards = track.querySelectorAll(".reel-card");
    if (!cards.length) return;
    const previous = currentIndex() - 1;
    if (previous < 0) {
      scrollToIndex(cards.length - 1, "auto");
      return;
    }
    scrollToIndex(previous);
  }

  function startAuto() {
    stopAuto();
    timer = window.setInterval(next, 8000);
  }

  function stopAuto() {
    if (timer) window.clearInterval(timer);
  }

  document.getElementById("reel-next")?.addEventListener("click", () => { next(); startAuto(); });
  document.getElementById("reel-prev")?.addEventListener("click", () => { prev(); startAuto(); });
  track?.addEventListener("scroll", updateDots, { passive: true });

  buildDots(track?.querySelectorAll(".reel-card").length || 0);
  startAuto();

  fetch("/api/products")
    .then((response) => (response.ok ? response.json() : null))
    .then((data) => {
      if (!data || !Array.isArray(data.products) || !data.products.length || !track) return;
      track.innerHTML = data.products.map(cardMarkup).join("");
      buildDots(data.products.length);
      updateDots();
      startAuto();
    })
    .catch(() => {});
</script>
