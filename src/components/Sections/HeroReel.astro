---
import { seedHeroSlides, normalizeHeroSlide } from "../../../netlify/functions/_lib/seed-hero.mjs";

const initialSlides = seedHeroSlides.map(normalizeHeroSlide).filter((slide) => slide.active);

function safeUrl(value) {
  const url = String(value || "").trim();
  return /^(https?:\/\/|\/|#|mailto:)/i.test(url) ? url : "";
}
---

<section class="hero-reel" id="hero-reel" aria-label="Productos destacados de CREATIVOX">
  <div class="hero-track" id="hero-slides">
    {
      initialSlides.map((slide, index) => (
        <article class:list={["hero-slide", index === 0 && "is-active"]} data-index={index}>
          <div class="hero-bg" data-bg={safeUrl(slide.backgroundImage)} aria-hidden="true"></div>
          <div class="hero-veil" aria-hidden="true"></div>

          <div class="container hero-content">
            <div class="hero-copy">
              {slide.eyebrow && (
                <span class="hero-eyebrow">
                  <span class="hero-dot"></span>
                  {slide.eyebrow}
                </span>
              )}

              <h1 class="hero-title">
                {slide.title && <span>{slide.title}</span>}
                {slide.highlight && <span class="hero-highlight">{slide.highlight}</span>}
              </h1>

              {slide.subtitle && <p class="hero-subtitle">{slide.subtitle}</p>}

              <div class="hero-actions">
                {slide.ctaText && (
                  <a class="hero-btn hero-btn-primary" href={safeUrl(slide.ctaLink) || "#"}>
                    {slide.ctaText}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </a>
                )}
                {slide.secondaryCtaText && (
                  <a class="hero-btn hero-btn-ghost" href={safeUrl(slide.secondaryCtaLink) || "#"}>
                    {slide.secondaryCtaText}
                  </a>
                )}
              </div>

              {(slide.stat1Value || slide.stat2Value || slide.stat3Value) && (
                <dl class="hero-stats">
                  {[
                    [slide.stat1Value, slide.stat1Label],
                    [slide.stat2Value, slide.stat2Label],
                    [slide.stat3Value, slide.stat3Label],
                  ]
                    .filter(([value]) => value)
                    .map(([value, label], statIndex) => (
                      <div class="hero-stat" key={statIndex}>
                        <dt>{value}</dt>
                        <dd>{label}</dd>
                      </div>
                    ))}
                </dl>
              )}
            </div>

            <div class="hero-visual" aria-hidden="true">
              <div class="hero-window">
                <div class="hero-window-bar">
                  <span class="hero-window-dots">
                    <i></i><i></i><i></i>
                  </span>
                  <span>{slide.previewLabel}</span>
                </div>
                <div class="hero-preview">
                  {slide.image ? (
                    <img
                      class="hero-preview-image"
                      src={safeUrl(slide.image)}
                      alt={slide.imageAlt || slide.title}
                      loading={index === 0 ? "eager" : "lazy"}
                    />
                  ) : (
                    <div class="hero-preview-text">
                      {slide.previewKicker && <p class="hero-preview-kicker">{slide.previewKicker}</p>}
                      {slide.previewText && <p class="hero-preview-line">{slide.previewText}</p>}
                      <div class="hero-preview-rule"></div>
                    </div>
                  )}
                  {slide.previewBadge && <span class="hero-preview-badge">{slide.previewBadge}</span>}
                </div>
              </div>
              <div class="hero-floating">
                <span class="hero-floating-icon">✓</span>
                <span>Listo para proyectar</span>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="hero-controls">
    <button id="hero-prev" class="hero-nav" type="button" aria-label="Diapositiva anterior">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <button id="hero-next" class="hero-nav" type="button" aria-label="Diapositiva siguiente">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </div>

  <div class="hero-footer">
    <div id="hero-dots" class="hero-dots" aria-hidden="true"></div>
    <span id="hero-counter" class="hero-counter"></span>
  </div>
  <div class="hero-progress"><span id="hero-progress-bar"></span></div>

  <script id="hero-seed" type="application/json" set:html={JSON.stringify(initialSlides)}></script>
</section>

<style>
  .hero-reel {
    --hero-ink: #080812;
    position: relative;
    min-height: 720px;
    overflow: hidden;
    background: radial-gradient(circle at 18% 20%, rgba(139, 92, 246, 0.42), transparent 42%),
      radial-gradient(circle at 82% 78%, rgba(37, 99, 235, 0.36), transparent 44%), var(--hero-ink);
    color: white;
    isolation: isolate;
  }

  .hero-track,
  .hero-slide {
    position: absolute;
    inset: 0;
  }

  .hero-slide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.85s ease, visibility 0.85s ease;
  }

  .hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .hero-bg {
    position: absolute;
    inset: -4%;
    background-position: center;
    background-size: cover;
    transform: scale(1.02);
    transition: transform 9s ease-out;
    filter: saturate(1.08);
  }

  .hero-slide.is-active .hero-bg {
    transform: scale(1.1);
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(8, 8, 18, 0.96) 0%, rgba(8, 8, 18, 0.82) 40%, rgba(8, 8, 18, 0.28) 72%, rgba(8, 8, 18, 0.62) 100%),
      linear-gradient(0deg, var(--hero-ink) 0%, rgba(8, 8, 18, 0) 38%);
  }

  .hero-content {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: 4rem;
    min-height: 720px;
    padding-top: 6rem;
    padding-bottom: 7rem;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #ddd6fe;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    backdrop-filter: blur(12px);
  }

  .hero-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #34d399;
    box-shadow: 0 0 14px rgba(52, 211, 153, 0.9);
  }

  .hero-title {
    margin: 1.6rem 0 0;
    display: grid;
    font-size: clamp(2.6rem, 5.6vw, 5rem);
    font-weight: 900;
    line-height: 1.03;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero-highlight {
    background: linear-gradient(90deg, #c4b5fd 0%, #818cf8 48%, #60a5fa 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-subtitle {
    max-width: 40rem;
    margin: 1.5rem 0 0;
    color: #cbd5e1;
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.2rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .hero-btn:hover {
    transform: translateY(-2px);
  }

  .hero-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .hero-btn-primary {
    background: linear-gradient(90deg, #7c3aed, #4f46e5);
    box-shadow: 0 18px 40px rgba(79, 70, 229, 0.35);
  }

  .hero-btn-ghost {
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
  }

  .hero-btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.12);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
    max-width: 32rem;
    margin: 2.8rem 0 0;
    padding-top: 1.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero-stat dt {
    font-size: 1.6rem;
    font-weight: 900;
    line-height: 1;
  }

  .hero-stat dd {
    margin: 0.35rem 0 0;
    color: #94a3b8;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 38rem;
    justify-self: end;
  }

  .hero-visual::before {
    content: "";
    position: absolute;
    inset: -2rem;
    border-radius: 3rem;
    background: rgba(255, 255, 255, 0.05);
    filter: blur(36px);
  }

  .hero-window {
    position: relative;
    padding: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 1.4rem;
    background: rgba(10, 10, 24, 0.82);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(18px);
  }

  .hero-window-bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.2rem 0.5rem 0.75rem;
    color: #64748b;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .hero-window-dots {
    display: inline-flex;
    gap: 0.35rem;
  }

  .hero-window-dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #fb7185;
  }

  .hero-window-dots i:nth-child(2) {
    background: #fbbf24;
  }

  .hero-window-dots i:nth-child(3) {
    background: #34d399;
  }

  .hero-preview {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.9rem;
    background: radial-gradient(circle at 25% 25%, rgba(139, 92, 246, 0.55), transparent 46%),
      radial-gradient(circle at 78% 72%, rgba(37, 99, 235, 0.45), transparent 46%),
      linear-gradient(135deg, #2e1065, #0b0b18 70%);
  }

  .hero-preview-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-preview-text {
    position: relative;
    z-index: 2;
    padding: 2rem;
    text-align: center;
  }

  .hero-preview-kicker {
    margin: 0;
    color: #c4b5fd;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .hero-preview-line {
    margin: 1.1rem 0 0;
    font-size: clamp(1.2rem, 2vw, 1.9rem);
    font-weight: 900;
    line-height: 1.25;
    text-wrap: balance;
  }

  .hero-preview-rule {
    width: 4rem;
    height: 0.25rem;
    margin: 1.4rem auto 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #c4b5fd, #60a5fa);
  }

  .hero-preview-badge {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    z-index: 3;
    padding: 0.3rem 0.55rem;
    border-radius: 0.4rem;
    background: rgba(0, 0, 0, 0.55);
    color: #cbd5e1;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .hero-floating {
    position: absolute;
    left: -1.4rem;
    bottom: -1.4rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.4);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    backdrop-filter: blur(14px);
  }

  .hero-floating-icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 0.5rem;
    background: rgba(16, 185, 129, 0.22);
    color: #6ee7b7;
    font-size: 1rem;
  }

  .hero-controls {
    position: absolute;
    right: 2rem;
    bottom: 2.2rem;
    z-index: 6;
    display: flex;
    gap: 0.6rem;
  }

  .hero-nav {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    color: white;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .hero-nav:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: scale(1.06);
  }

  .hero-nav svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .hero-footer {
    position: absolute;
    left: 2rem;
    bottom: 2.5rem;
    z-index: 6;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hero-dots {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-dot-button {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.3);
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease;
  }

  .hero-dot-button.is-active {
    width: 2rem;
    background: #a78bfa;
  }

  .hero-counter {
    color: #cbd5e1;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .hero-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 7;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
  }

  .hero-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, #a78bfa, #60a5fa);
  }

  @media (max-width: 900px) {
    .hero-reel,
    .hero-content {
      min-height: auto;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 5rem;
      padding-bottom: 7.5rem;
    }

    .hero-visual {
      max-width: 100%;
      justify-self: stretch;
    }

    .hero-floating {
      left: 0.5rem;
      bottom: -1rem;
    }

    .hero-controls {
      right: 1rem;
      bottom: 1.2rem;
    }

    .hero-footer {
      left: 1rem;
      bottom: 1.6rem;
    }
  }

  @media (max-width: 560px) {
    .hero-stats {
      gap: 0.8rem;
    }

    .hero-stat dt {
      font-size: 1.25rem;
    }

    .hero-stat dd {
      font-size: 0.62rem;
    }

    .hero-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  const root = document.getElementById("hero-reel");
  const track = document.getElementById("hero-slides");
  const dots = document.getElementById("hero-dots");
  const counter = document.getElementById("hero-counter");
  const progress = document.getElementById("hero-progress-bar");
  const seedNode = document.getElementById("hero-seed");

  const DURATION = 7000;
  let slides = [];
  let index = 0;
  let timer;
  let paused = false;

  const esc = (value) =>
    String(value ?? "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    })[char]);

  function safeUrl(value) {
    const url = String(value || "").trim();
    return /^(https?:\/\/|\/|#|mailto:)/i.test(url) ? url : "";
  }

  function statsMarkup(slide) {
    const stats = [
      [slide.stat1Value, slide.stat1Label],
      [slide.stat2Value, slide.stat2Label],
      [slide.stat3Value, slide.stat3Label],
    ].filter(([value]) => value);
    if (!stats.length) return "";
    return `<dl class="hero-stats">${stats
      .map(
        ([value, label]) =>
          `<div class="hero-stat"><dt>${esc(value)}</dt><dd>${esc(label)}</dd></div>`,
      )
      .join("")}</dl>`;
  }

  function slideMarkup(slide, position) {
    const background = safeUrl(slide.backgroundImage);
    const image = safeUrl(slide.image);
    const preview = image
      ? `<img class="hero-preview-image" src="${esc(image)}" alt="${esc(slide.imageAlt || slide.title)}" loading="${position === 0 ? "eager" : "lazy"}" />`
      : `<div class="hero-preview-text">${
          slide.previewKicker ? `<p class="hero-preview-kicker">${esc(slide.previewKicker)}</p>` : ""
        }${
          slide.previewText ? `<p class="hero-preview-line">${esc(slide.previewText)}</p>` : ""
        }<div class="hero-preview-rule"></div></div>`;

    return `
      <article class="hero-slide${position === 0 ? " is-active" : ""}" data-index="${position}">
        <div class="hero-bg" data-bg="${esc(background)}" aria-hidden="true"></div>
        <div class="hero-veil" aria-hidden="true"></div>
        <div class="container hero-content">
          <div class="hero-copy">
            ${
              slide.eyebrow
                ? `<span class="hero-eyebrow"><span class="hero-dot"></span>${esc(slide.eyebrow)}</span>`
                : ""
            }
            <h1 class="hero-title">
              ${slide.title ? `<span>${esc(slide.title)}</span>` : ""}
              ${slide.highlight ? `<span class="hero-highlight">${esc(slide.highlight)}</span>` : ""}
            </h1>
            ${slide.subtitle ? `<p class="hero-subtitle">${esc(slide.subtitle)}</p>` : ""}
            <div class="hero-actions">
              ${
                slide.ctaText
                  ? `<a class="hero-btn hero-btn-primary" href="${esc(safeUrl(slide.ctaLink) || "#")}">${esc(slide.ctaText)}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg></a>`
                  : ""
              }
              ${
                slide.secondaryCtaText
                  ? `<a class="hero-btn hero-btn-ghost" href="${esc(safeUrl(slide.secondaryCtaLink) || "#")}">${esc(slide.secondaryCtaText)}</a>`
                  : ""
              }
            </div>
            ${statsMarkup(slide)}
          </div>
          <div class="hero-visual" aria-hidden="true">
            <div class="hero-window">
              <div class="hero-window-bar">
                <span class="hero-window-dots"><i></i><i></i><i></i></span>
                <span>${esc(slide.previewLabel)}</span>
              </div>
              <div class="hero-preview">
                ${preview}
                ${
                  slide.previewBadge
                    ? `<span class="hero-preview-badge">${esc(slide.previewBadge)}</span>`
                    : ""
                }
              </div>
            </div>
            <div class="hero-floating">
              <span class="hero-floating-icon">✓</span>
              <span>Listo para proyectar</span>
            </div>
          </div>
        </div>
      </article>`;
  }

  function applyBackgrounds() {
    if (!track) return;
    track.querySelectorAll(".hero-bg").forEach((node) => {
      const url = safeUrl(node.dataset.bg || "");
      node.style.backgroundImage = url ? `url("${url.replace(/"/g, "%22").replace(/'/g, "%27")}")` : "";
    });
  }

  function buildDots() {
    if (!dots) return;
    dots.innerHTML = slides
      .map((_, dotIndex) => `<button class="hero-dot-button" type="button" data-hero-dot="${dotIndex}" aria-label="Ir a la diapositiva ${dotIndex + 1}"></button>`)
      .join("");
    dots.querySelectorAll("[data-hero-dot]").forEach((button) => {
      button.addEventListener("click", () => {
        show(Number(button.dataset.heroDot));
        start();
      });
    });
  }

  function restartProgress() {
    if (!progress) return;
    progress.style.transition = "none";
    progress.style.width = "0%";
    void progress.offsetWidth;
    progress.style.transition = `width ${DURATION}ms linear`;
    progress.style.width = "100%";
  }

  function show(next) {
    if (!track || !slides.length) return;
    index = (next + slides.length) % slides.length;
    track.querySelectorAll(".hero-slide").forEach((node, nodeIndex) => {
      node.classList.toggle("is-active", nodeIndex === index);
    });
    dots?.querySelectorAll("[data-hero-dot]").forEach((node, nodeIndex) => {
      node.classList.toggle("is-active", nodeIndex === index);
    });
    if (counter) counter.textContent = `${String(index + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
    restartProgress();
  }

  function start() {
    stop();
    if (slides.length < 2 || paused) return;
    timer = window.setInterval(() => show(index + 1), DURATION);
  }

  function stop() {
    if (timer) window.clearInterval(timer);
    timer = undefined;
  }

  function render(items) {
    slides = Array.isArray(items) ? items : [];
    if (!track) return;
    if (!slides.length) {
      track.innerHTML = "";
      if (counter) counter.textContent = "00 / 00";
      if (dots) dots.innerHTML = "";
      stop();
      return;
    }
    track.innerHTML = slides.map(slideMarkup).join("");
    applyBackgrounds();
    buildDots();
    show(0);
    start();
  }

  function readSeed() {
    try {
      return JSON.parse(seedNode?.textContent || "[]");
    } catch {
      return [];
    }
  }

  document.getElementById("hero-prev")?.addEventListener("click", () => {
    show(index - 1);
    start();
  });

  document.getElementById("hero-next")?.addEventListener("click", () => {
    show(index + 1);
    start();
  });

  root?.addEventListener("mouseenter", () => {
    paused = true;
    stop();
  });

  root?.addEventListener("mouseleave", () => {
    paused = false;
    start();
  });

  document.addEventListener("keydown", (event) => {
    if (!root || !slides.length) return;
    const box = root.getBoundingClientRect();
    if (box.bottom < 0 || box.top > window.innerHeight) return;
    if (event.key === "ArrowLeft") show(index - 1);
    if (event.key === "ArrowRight") show(index + 1);
  });

  let touchStartX = 0;
  root?.addEventListener("touchstart", (event) => {
    touchStartX = event.touches[0]?.clientX || 0;
  }, { passive: true });

  root?.addEventListener("touchend", (event) => {
    const delta = (event.changedTouches[0]?.clientX || 0) - touchStartX;
    if (Math.abs(delta) < 45) return;
    show(delta > 0 ? index - 1 : index + 1);
    start();
  }, { passive: true });

  render(readSeed());

  fetch("/api/hero")
    .then((response) => (response.ok ? response.json() : null))
    .then((data) => {
      if (!data || !Array.isArray(data.slides)) return;
      const remote = data.slides;
      // La web es estática y el HTML trae las diapositivas semilla. Si el admin
      // editó una diapositiva existente, los IDs no cambian: hay que comparar
      // el contenido completo, no solo la cantidad de slides.
      if (JSON.stringify(remote) !== JSON.stringify(slides)) {
        render(remote);
      }
    })
    .catch(() => {});
</script>
