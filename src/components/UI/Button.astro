---
export interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "outline";
  size?: "sm" | "md" | "lg";
  class?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  target,
  rel,
  disabled = false,
  type = "button",
  ariaLabel,
  ...rest
} = Astro.props;

const base = "inline-flex items-center justify-center gap-2 rounded-xl font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-violet-500 disabled:opacity-50 disabled:cursor-not-allowed min-h-[44px]";

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-sm",
  lg: "px-8 py-4 text-base",
};

const variants = {
  primary: "brand-gradient text-white shadow-lg shadow-violet-900/30 hover:shadow-glow",
  secondary: "bg-white text-ink-900 hover:bg-slate-100",
  ghost: "bg-white/10 text-white border border-white/20 hover:bg-white/20 backdrop-blur",
  outline: "border border-slate-300 bg-white text-slate-800 hover:border-violet-400 hover:text-violet-700",
};

const Element = href ? "a" : "button";
---

<Element
  href={href}
  class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : rel}
  disabled={disabled}
  type={!href ? type : undefined}
  aria-label={ariaLabel}
  {...rest}
>
  <slot />
</Element>
