# Copia este archivo a .env y ajusta los valores antes de desarrollar en local.
# Nunca subas .env a GitHub.

# Hash scrypt de la clave del panel. Se genera con:
# node -e "const c=require('node:crypto');const s=c.randomBytes(16);const h=c.scryptSync('TU_CLAVE',s,64);console.log('scrypt$'+s.toString('hex')+'$'+h.toString('hex'))"
ADMIN_PASSWORD_HASH=

# Secreto para firmar las cookies de sesión (64 hex recomendados).
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Horas de validez de la sesión.
ADMIN_SESSION_HOURS=168
